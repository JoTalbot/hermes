[Unit]
Description=Hermes agents runtime (bus-attached agents: orchestrator, guardian, github, security, monitoring, backup, projects)
Documentation=file:/opt/hermes/docs/RUNBOOK.md /opt/hermes/agents/runtime.py
After=network-online.target nats-server.service hermes-bus-bridge.service
Wants=network-online.target nats-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/hermes/.venv-bus/bin/python /opt/hermes/agents/runtime.py run
Restart=always
RestartSec=5
# Root is required because the checks read systemd, ufw, docker and file modes. The
# agents themselves can only execute handlers declared in config/agents/*.yaml — a bus
# message names a handler, never a command — so "root" here does not mean "arbitrary
# code from the network".
User=root
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/hermes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-agents
PrivateTmp=true
ProtectHome=no

[Install]
WantedBy=multi-user.target
