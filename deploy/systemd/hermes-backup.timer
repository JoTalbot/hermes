[Unit]
Description=Nightly Hermes backup (03:30 UTC) with restore verification
Documentation=file:///opt/hermes/docs/RUNBOOK.md

[Timer]
# 03:30 UTC = 06:30 in Kyiv — outside the windows when the agent bus is busy.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=900
# A box that was off at 03:30 still gets its backup when it comes back.
Persistent=true
Unit=hermes-backup.service

[Install]
WantedBy=timers.target
