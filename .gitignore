# === hard rule: nothing secret, nothing runtime ===
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
*.p12
*.kdbx
secrets/
token*
*_token
authorized_keys
sessions/
logs/
cache/
*.log
*.db
*.db-wal
*.db-shm
__pycache__/
*.pyc
.venv/
.venv-bus/
venv/
node_modules/
dist/
# runtime state stays on the server; only state/README.md is tracked
state/*
!state/README.md
# audit scratch — must never be committed
audit*.sh
probe.sh
*.pub
*.ppk
# Журналы проектов — состояние, а не код: их пишут act.sh и project-run.sh на узле.
# В репозитории они сделали бы каждый проект «грязным» навсегда и врали бы в отчётах.
memory/projects/*/JOURNAL.md
