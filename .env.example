# Copy to .env on the SERVER (0600, owned by ubuntu). NEVER commit the real file.
# This file documents variables only. No real values here.

# --- LLM Balancer shim (OpenAI-compatible front for octopus-aios-bridge) ---
HERMES_BALANCER_URL=http://127.0.0.1:9700/v1
# Loopback-only shared secret. Generate on the server:
#   head -c 24 /dev/urandom | base64 | tr -d '\n'
HERMES_BALANCER_API_KEY=__GENERATE_ON_SERVER__

# Upstream AIOS bridge the shim fronts
AIOS_BRIDGE_URL=http://127.0.0.1:9600

# --- Hermes ---
HERMES_HOME=/home/hermes/.hermes

# --- GitHub sync (set on server only; the GitHub Agent needs it) ---
GITHUB_TOKEN=__GENERATE_ON_SERVER_FINE_GRAINED_REPO_ONLY__

# --- Telegram (only if you deliberately move the Hermes gateway off liza) ---
# TELEGRAM_BOT_TOKEN=
